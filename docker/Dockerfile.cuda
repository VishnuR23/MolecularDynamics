FROM nvidia/cuda:12.2.0-devel-ubuntu22.04
WORKDIR /workspace
RUN apt-get update && apt-get install -y python3 python3-pip python3-venv build-essential cmake git && rm -rf /var/lib/apt/lists/*
COPY requirements.txt .
RUN python3 -m pip install --upgrade pip && pip3 install --no-cache-dir -r requirements.txt
COPY . .
RUN python3 setup.py build_ext --inplace
CMD ["/bin/bash"]
